# このファイルを .env という名前でコピーし、値を書き換えてください（.env は Git に入りません）
GEMINI_API_KEY=ここにAPIキー
# 声を変える場合（例: 女性は Kore / Aoede、男性は Charon / Puck）
# GEMINI_TTS_VOICE=Charon
# 読み方の指示を変える場合
# GEMINI_TTS_STYLE=歴史ドキュメンタリーのナレーターとして、落ち着いた温かい声で、ゆっくり自然な間をとって読んでください
# モデルを変える場合（新しいTTSモデルが出たとき）
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 出力先をGoogleドライブ等の同期フォルダにする場合
# VIDEO_OUT_DIR=G:\マイドライブ\X投稿
